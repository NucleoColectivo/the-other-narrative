rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE SEGURIDAD Y AUTORIZACIÓN ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Valida que el email pertenezca a la lista autorizada de administradores
    function isAuthorizedEmail() {
      return isSignedIn() && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'angelamgomez@gmail.com' || 
          request.auth.token.email.lower() == 'nucleo.colectivo.art@gmail.com' ||
          request.auth.token.email.lower() == 'nucleo.colectivo.art2@gmail.com'
        );
    }

    // Verifica si el usuario es administrador por email directo o por registro en adminRoles
    function isAdmin() {
      return isAuthorizedEmail() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // --- ROLES ADMINISTRATIVOS ---
    match /adminRoles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthorizedEmail() || isAdmin(); 
    }

    // --- CONTENIDO EDITORIAL Y PORTAFOLIO (Lectura pública, mutaciones solo Admin) ---
    match /contentItems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /podcasts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featuredVideos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resources/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Permitir a visitantes públicos incrementar únicamente el contador de descargas
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount'])
      );
    }

    // --- MENSAJES DE CONTACTO ---
    // Cualquier visitante público puede enviar mensajes, pero NADIE público puede leer o borrar
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Regla de cierre de seguridad para cualquier otra ruta no declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
